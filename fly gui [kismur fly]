-- ============ FLY ENGINE ============
local fly = { conn = nil, hum = nil, hrp = nil }

local function stopFly()
    if fly.conn then fly.conn:Disconnect(); fly.conn = nil end
    if fly.hum then
        pcall(function() fly.hum.PlatformStand = false end)
        pcall(function() fly.hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        pcall(function() fly.hum.WalkSpeed = 16 end)
    end
    fly.hum = nil; fly.hrp = nil
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    fly.hrp = char:FindFirstChild("HumanoidRootPart")
    fly.hum = char:FindFirstChildOfClass("Humanoid")
    if not fly.hrp or not fly.hum then return end

    fly.hum.PlatformStand = true

    fly.conn = RunService.RenderStepped:Connect(function(dt)
        if not fly.hrp or not fly.hrp.Parent or not fly.hum then return end
        local cam = Workspace.CurrentCamera
        if not cam then return end

        local move = Vector3.zero
        local fwd, right = cam.CFrame.LookVector, cam.CFrame.RightVector
        if UserInput:IsKeyDown(Enum.KeyCode.W) then move += fwd end
        if UserInput:IsKeyDown(Enum.KeyCode.S) then move -= fwd end
        if UserInput:IsKeyDown(Enum.KeyCode.D) then move += right end
        if UserInput:IsKeyDown(Enum.KeyCode.A) then move -= right end
        if UserInput:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0,1,0) end
        if UserInput:IsKeyDown(Enum.KeyCode.LeftShift) then move -= Vector3.new(0,1,0) end

        local currentCFrame = fly.hrp.CFrame
        local newPos = currentCFrame.Position

        if move.Magnitude > 0 then 
            newPos += move.Unit * flySpeed * dt 
        end

        local targetCFrame = CFrame.new(newPos, newPos + fwd)
        fly.hrp.CFrame = fly.hrp.CFrame:Lerp(targetCFrame, 1)
        fly.hrp.Velocity = Vector3.zero
    end)
end

task.spawn(function()
    local last = false
    while gui.Parent do
        if tFly.value ~= last then
            last = tFly.value
            if last then startFly() else stopFly() end
        end
        task.wait(0.1)
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if tFly.value then
        task.wait(0.4)
        startFly()
    end
end)

