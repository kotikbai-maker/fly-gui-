-- ============ Theme apply ============
local function applyTheme(name)
    currentTheme = name
    T = Themes[name]
    TweenService:Create(main, TweenInfo.new(0.25), {BackgroundColor3 = T.bg}):Play()
    TweenService:Create(header, TweenInfo.new(0.25), {BackgroundColor3 = T.surface}):Play()
    mainStroke.Color = T.stroke
    headerGrad.Color = ColorSequence.new(T.accent, T.accent2)
    accentLine.BackgroundColor3 = T.accent
    accentLineGrad.Color = ColorSequence.new(T.accent, T.accent2)
    themeBtnGrad.Color = ColorSequence.new(T.accent, T.accent2)
    for _, obj in pairs(page:GetChildren()) do
        if obj:IsA("Frame") or obj:IsA("TextButton") then
            obj.BackgroundColor3 = T.element
            for _, st in pairs(obj:GetChildren()) do
                if st:IsA("UIStroke") then st.Color = T.stroke end
                if st:IsA("TextLabel") then st.TextColor3 = T.text end
            end
        end
    end
    for _, sl in pairs(sliders) do
        sl.frame.BackgroundColor3 = T.element
        sl.fill.BackgroundColor3 = T.accent
        sl.fillGrad.Color = ColorSequence.new(T.accent, T.accent2)
        sl.valueLabel.TextColor3 = T.accent
    end
    for _, entry in pairs(toggles) do entry.render(false) end
    page.ScrollBarImageColor3 = T.accent
    themeBtn.Text = name
end
themeBtn.MouseButton1Click:Connect(function()
    local idx = table.find(themeOrder, currentTheme) or 1
    idx = (idx % #themeOrder) + 1
    applyTheme(themeOrder[idx])
end)

