local toggles = {}
local function addToggle(text, order, defaultState, onChange)
    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.element,
        Font = Enum.Font.Gotham, Text = "", AutoButtonColor = false,
        LayoutOrder = order, Parent = page
    })
    corner(btn, 8)
    local btnStroke = stroke(btn, T.stroke, 1)
    new("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1, Font = Enum.Font.Gotham, Text = text,
        TextSize = 13, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn
    })
    local pill = new("Frame", {
        Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -54, 0.5, -10),
        BackgroundColor3 = defaultState and T.accent or T.surface, Parent = btn
    })
    corner(pill, 10)
    local dot = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = defaultState and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255,255,255), Parent = pill
    })
    corner(dot, 8)
    
    local state = {value = defaultState}
    local function render(animate)
        local ti = animate and TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out) or TweenInfo.new(0)
        TweenService:Create(pill, ti, {BackgroundColor3 = state.value and T.accent or T.surface}):Play()
        TweenService:Create(dot, ti, {Position = state.value and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
    end
    render(false)
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = T.surface}):Play()
        TweenService:Create(btnStroke, TweenInfo.new(0.15), {Color = T.accent}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = T.element}):Play()
        TweenService:Create(btnStroke, TweenInfo.new(0.15), {Color = T.stroke}):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        state.value = not state.value
        render(true)
        local origSize = btn.Size
        TweenService:Create(btn, TweenInfo.new(0.08), {Size = UDim2.new(1, -4, 0, 38)}):Play()
        task.delay(0.08, function()
            TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = origSize}):Play()
        end)
        if onChange then onChange(state.value) end
    end)
    toggles[text] = {state = state, render = render, pill = pill}
    return state
end

-- ============ Slider ============
local sliders = {}
local function addSlider(text, order, min, max, default, onChange)
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = T.element,
        LayoutOrder = order, Parent = page
    })
    corner(frame, 8)
    local frameStroke = stroke(frame, T.stroke, 1)
    new("TextLabel", {
        Size = UDim2.new(1, -90, 0, 22), Position = UDim2.new(0, 14, 0, 6),
        BackgroundTransparency = 1, Font = Enum.Font.Gotham, Text = text,
        TextSize = 12, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame
    })
    local valueLabel = new("TextLabel", {
        Size = UDim2.new(0, 60, 0, 22), Position = UDim2.new(1, -74, 0, 6),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = tostring(default),
        TextSize = 12, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = frame
    })
    local bar = new("Frame", {
        Size = UDim2.new(1, -28, 0, 6), Position = UDim2.new(0, 14, 0, 40),
        BackgroundColor3 = T.surface, Parent = frame
    })
    corner(bar, 3)
    local fill = new("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = T.accent, BorderSizePixel = 0, Parent = bar
    })
    corner(fill, 3)
    local fillGrad = grad(fill, T.accent, T.accent2, 0)

    local dragging = false
    local function setValue(px)
        local rel = math.clamp((px - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valueLabel.Text = tostring(val)
        if onChange then onChange(val) end
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; setValue(i.Position.X)
            TweenService:Create(fill, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(255,255,255)}):Play()
        end
    end)
    UserInput.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setValue(i.Position.X)
        end
    end)
    UserInput.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            TweenService:Create(fill, TweenInfo.new(0.2), {BackgroundColor3 = T.accent}):Play()
        end
    end)
    frame.MouseEnter:Connect(function() TweenService:Create(frameStroke, TweenInfo.new(0.15), {Color = T.accent}):Play() end)
    frame.MouseLeave:Connect(function() TweenService:Create(frameStroke, TweenInfo.new(0.15), {Color = T.stroke}):Play() end)
    local entry = {frame = frame, fill = fill, fillGrad = fillGrad, valueLabel = valueLabel, stroke = frameStroke}
    sliders[text] = entry
    return entry
end

